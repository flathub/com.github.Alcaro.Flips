{
    "app-id" : "com.github.Alcaro.Flips",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command" : "flips",
    "finish-args" : [
        /* X11 + XShm access */
        "--share=ipc",
        "--socket=fallback-x11",
        /* Wayland access */
        "--socket=wayland",
        /* OpenGL + DRI access */
        "--device=dri",
        /* Needed to save patched ROMs */
        "--filesystem=home",
        /* Needed to find the ROMs and patches */
        "--filesystem=host:ro"
    ],
    "modules" : [
        {
            "name" : "flips",
            "buildsystem" : "simple",
            "build-commands": [
                "sh make-linux.sh --cflags=-DFLATPAK",
                "make install PREFIX=/app"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://git.disroot.org/Sir_Walrus/Flips",
                    "branch" : "359d414cff73b3e0400871d3c288a59b36564834"
                }
            ]
        }
    ]
}
